# ============================================================
# DharmaPath Pipeline — Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit .env to git.
# ============================================================

# ── ComfyUI (RunPod) ─────────────────────────────────────────
# The public URL of your RunPod ComfyUI instance.
# Format: https://<pod-id>-8188.proxy.runpod.net
COMFYUI_BASE_URL=https://your-runpod-id-8188.proxy.runpod.net

# Optional: RunPod API key if your instance requires auth headers
RUNPOD_API_KEY=

# ── Cloudflare R2 ────────────────────────────────────────────
# Found in: Cloudflare Dashboard → R2 → Manage R2 API tokens
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=dharmapath
# R2 endpoint — do not change format
R2_ENDPOINT_URL=https://${R2_ACCOUNT_ID}.r2.cloudflarestorage.com

# ── Pipeline Behaviour ───────────────────────────────────────
# Directory paths (relative to repo root, inside WSL)
SCREENPLAYS_DIR=data/screenplays
OUTPUTS_DIR=data/outputs
CHARACTERS_DIR=data/characters
CHARACTERS_FULL_DIR=data/characters_full
CANDIDATES_DIR=data/candidates
POSES_DIR=data/poses

# Number of panels to generate before uploading batch to R2
R2_BATCH_UPLOAD_INTERVAL=5

# ── Web Server ───────────────────────────────────────────────
# Host/port for the FastAPI dev server (uvicorn)
WEB_HOST=0.0.0.0
WEB_PORT=8000

# Set to "development" or "production"
APP_ENV=development

# ── Logging ──────────────────────────────────────────────────
# Log level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
