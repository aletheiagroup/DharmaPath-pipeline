# ============================================================
# DharmaPath Pipeline — Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit .env to git.
# ============================================================

# ── ComfyUI (GCE VM) ─────────────────────────────────────────
# The external IP of your GCE g2-standard-4 VM running ComfyUI.
# After running scripts/gcp_setup.sh, the script prints this URL.
# Format: http://<GCE_EXTERNAL_IP>:8188
COMFYUI_BASE_URL=http://YOUR_GCE_VM_IP:8188

# Optional: RunPod API key (only needed if still using RunPod)
RUNPOD_API_KEY=

# ── Google Cloud Platform ────────────────────────────────────
# Your GCP project ID (found in GCP Console dashboard)
GCP_PROJECT_ID=your-gcp-project-id

# Region for GCP services (asia-south1 = Mumbai)
GCP_REGION=asia-south1

# ── Gemini API ───────────────────────────────────────────────
# Model to use for prompt refinement, QC review, screenplay generation.
# Options: gemini-2.0-flash (fast/cheap), gemini-2.0-pro (higher quality)
GEMINI_MODEL=gemini-2.0-flash

# Google API key for Gemini. Get one at: https://aistudio.google.com/apikey
# Leave empty if running on GCE with Application Default Credentials.
GOOGLE_API_KEY=

# ── Google Cloud Storage (optional) ──────────────────────────
# If you want to use GCS instead of Cloudflare R2 for asset storage.
GCS_BUCKET_NAME=dharmapath

# ── Cloudflare R2 (legacy — still works) ─────────────────────
# Found in: Cloudflare Dashboard → R2 → Manage R2 API tokens
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=dharmapath
# R2 endpoint — do not change format
R2_ENDPOINT_URL=https://${R2_ACCOUNT_ID}.r2.cloudflarestorage.com

# ── Pipeline Behaviour ───────────────────────────────────────
# Directory paths (relative to repo root)
SCREENPLAYS_DIR=data/screenplays
OUTPUTS_DIR=data/outputs
CHARACTERS_DIR=data/characters
CHARACTERS_FULL_DIR=data/characters_full
CANDIDATES_DIR=data/candidates
POSES_DIR=data/poses

# Number of panels to generate before uploading batch to cloud storage
R2_BATCH_UPLOAD_INTERVAL=5

# ── Web Server ───────────────────────────────────────────────
# Host/port for the FastAPI dev server (uvicorn)
WEB_HOST=0.0.0.0
WEB_PORT=8000

# Set to "development" or "production"
APP_ENV=development

# ── Logging ──────────────────────────────────────────────────
# Log level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
