{
  "_comment": "Character candidate generation workflow. Generates portrait-style character images for human selection. 9 variations are generated per character (3x3 lighting x expression x angle).",
  "3": {
    "class_type": "KSampler",
    "_meta": { "title": "KSampler" },
    "inputs": {
      "model": ["10", 0],
      "positive": ["6", 0],
      "negative": ["7", 0],
      "latent_image": ["5", 0],
      "seed": 42,
      "steps": 30,
      "cfg": 7.0,
      "sampler_name": "dpmpp_2m_karras",
      "scheduler": "karras",
      "denoise": 1.0
    }
  },
  "4": {
    "class_type": "CheckpointLoaderSimple",
    "_meta": { "title": "Load Checkpoint" },
    "inputs": {
      "ckpt_name": "animagineXLV31_v31.safetensors"
    }
  },
  "5": {
    "class_type": "EmptyLatentImage",
    "_meta": { "title": "Empty Latent (Portrait)" },
    "inputs": {
      "width": 512,
      "height": 768,
      "batch_size": 1
    }
  },
  "6": {
    "class_type": "CLIPTextEncode",
    "_meta": { "title": "CLIP Text Encode (Positive)" },
    "inputs": {
      "text": "PLACEHOLDER_POSITIVE",
      "clip": ["4", 1]
    }
  },
  "7": {
    "class_type": "CLIPTextEncode",
    "_meta": { "title": "CLIP Text Encode (Negative)" },
    "inputs": {
      "text": "PLACEHOLDER_NEGATIVE",
      "clip": ["4", 1]
    }
  },
  "8": {
    "class_type": "VAEDecode",
    "_meta": { "title": "VAE Decode" },
    "inputs": {
      "samples": ["3", 0],
      "vae": ["4", 2]
    }
  },
  "10": {
    "class_type": "LoraLoader",
    "_meta": { "title": "Style LoRA" },
    "inputs": {
      "model": ["4", 0],
      "clip": ["4", 1],
      "lora_name": "itihaasa_style_v1.safetensors",
      "strength_model": 0.85,
      "strength_clip": 0.85
    }
  },
  "35": {
    "class_type": "SaveImage",
    "_meta": { "title": "Save Candidate Image" },
    "inputs": {
      "images": ["8", 0],
      "filename_prefix": "candidate_character_01"
    }
  }
}
