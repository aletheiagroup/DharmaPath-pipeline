{
  "_comment": "Inpainting workflow stub — used for correcting flagged panels. Loads original panel image + mask, repaints masked region at denoise=0.65. TODO: wire to real inpaint workflow from RunPod.",
  "3": {
    "class_type": "KSampler",
    "_meta": { "title": "KSampler (Inpaint)" },
    "inputs": {
      "model": ["10", 0],
      "positive": ["6", 0],
      "negative": ["7", 0],
      "latent_image": ["51", 0],
      "seed": 42,
      "steps": 30,
      "cfg": 7.0,
      "sampler_name": "dpmpp_2m_karras",
      "scheduler": "karras",
      "denoise": 0.65
    }
  },
  "4": {
    "class_type": "CheckpointLoaderSimple",
    "_meta": { "title": "Load Checkpoint" },
    "inputs": {
      "ckpt_name": "animagineXLV31_v31.safetensors"
    }
  },
  "6": {
    "class_type": "CLIPTextEncode",
    "_meta": { "title": "CLIP Text Encode (Positive)" },
    "inputs": {
      "text": "PLACEHOLDER_POSITIVE",
      "clip": ["4", 1]
    }
  },
  "7": {
    "class_type": "CLIPTextEncode",
    "_meta": { "title": "CLIP Text Encode (Negative)" },
    "inputs": {
      "text": "PLACEHOLDER_NEGATIVE",
      "clip": ["4", 1]
    }
  },
  "8": {
    "class_type": "VAEDecode",
    "_meta": { "title": "VAE Decode" },
    "inputs": {
      "samples": ["3", 0],
      "vae": ["4", 2]
    }
  },
  "10": {
    "class_type": "LoraLoader",
    "_meta": { "title": "Style LoRA" },
    "inputs": {
      "model": ["4", 0],
      "clip": ["4", 1],
      "lora_name": "itihaasa_style_v1.safetensors",
      "strength_model": 0.85,
      "strength_clip": 0.85
    }
  },
  "49": {
    "class_type": "LoadImage",
    "_meta": { "title": "Load Original Panel" },
    "inputs": {
      "image": "PLACEHOLDER_PANEL_PATH",
      "upload": "image"
    }
  },
  "50": {
    "class_type": "LoadImageMask",
    "_meta": { "title": "Load Inpaint Mask" },
    "inputs": {
      "image": "PLACEHOLDER_MASK_PATH",
      "channel": "red",
      "upload": "image"
    }
  },
  "51": {
    "class_type": "VAEEncodeForInpaint",
    "_meta": { "title": "VAE Encode for Inpaint" },
    "inputs": {
      "pixels": ["49", 0],
      "vae": ["4", 2],
      "mask": ["50", 0],
      "grow_mask_by": 6
    }
  },
  "35": {
    "class_type": "SaveImage",
    "_meta": { "title": "Save Inpainted Panel" },
    "inputs": {
      "images": ["8", 0],
      "filename_prefix": "inpaint_result"
    }
  }
}
