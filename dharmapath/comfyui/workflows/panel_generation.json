{
  "_comment": "DharmaPath panel generation workflow. Export your real ComfyUI workflow as API JSON and replace this stub. Node IDs must match the constants in workflow_builder.py NodeID class.",
  "3": {
    "class_type": "KSampler",
    "_meta": { "title": "KSampler" },
    "inputs": {
      "model": ["10", 0],
      "positive": ["6", 0],
      "negative": ["7", 0],
      "latent_image": ["5", 0],
      "seed": 42,
      "steps": 30,
      "cfg": 7.0,
      "sampler_name": "dpmpp_2m_karras",
      "scheduler": "karras",
      "denoise": 1.0
